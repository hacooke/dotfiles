{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "top-bar",
      "type": "block",
      "size": { "px": 24 },
      "content": {
        "mod": "minimal-airline",
        "props": {
          "machine_color": "ansi4",
          "space_color": "solid",
          "tab_color": "accent",
          "agent_tray_color": "ansi5"
        }
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "resizable": false,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": { "px": 268 },
          "min": 44,
          "max": 480,
          "hidden": true,
          "background": "chrome",
          "resizable": false,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "spaces" }
            },
            {
              "id": "agents",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "agents" }
            },
            {
              "id": "sidebar-status",
              "type": "block",
              "size": { "px": 30 },
              "content": { "mod": "minimal-airline", "props": { "footer": true } }
            }
          ]
        },
        {
          "id": "work",
          "type": "row",
          "resizable": false,
          "children": [
            {
              "id": "main",
              "type": "block",
              "size": { "weight": 1 },
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "lone": false,
                  "radius": 8,
                  "background": "background",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": { "mod": "files" }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": { "mod": "changes" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "background": "background",
  "preview": "layouts/minimal.svg",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "terminal_padding": [2, 2]
}
