// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 0,
    "output": "eDP-1",

    "reload_style_on_change": true,

    "modules-left": [
        "custom/icon",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [ "clock" ],
    "modules-right": [
        "tray",
        //"custom/cpucores",
        // "custom/hyprwhspr",
        "wireplumber#source",
        "pulseaudio#sink",
        "network",
        "backlight",
        "battery"
    ],
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active":  "",
            "empty":   "◦",
            "default": "•"
        },
        "sort-by-number": true,
        "persistent-workspaces": {
            "eDP-1": 12
        }
    },
    "include": [
        "~/.config/waybar/modules.jsonc",
        "/home/harry/.config/waybar/hyprwhspr-module.jsonc"
    ]
} 
