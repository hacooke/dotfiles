#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: agent-orchestrator [--repo ALIAS|PATH] [--base BRANCH] [--help] [REQUEST...]

Start the persistent Pi multi-build orchestrator (Oscar) in a Herdr-managed terminal.
The known-repos skill provides a shared convenience catalog, not an allowlist.
Explicit paths and new repositories are also supported.

Options:
  --repo ALIAS|PATH  Suggest a repository alias or exact workspace path
  --base BRANCH     Request a base branch
  --help            Show this help

Without --repo, give Oscar the task in natural language. For repositories not
in the map, Oscar must confirm the exact path with you before working there.
USAGE
}

fail() {
    printf 'agent-orchestrator: %s\n' "$*" >&2
    exit 1
}

repo_request=''
base_branch=''
request_parts=()
while (($#)); do
    case $1 in
        --help|-h)
            usage
            exit 0
            ;;
        --repo|--base)
            option=$1
            (($# >= 2)) || fail "$option requires a value"
            [[ -n $2 ]] || fail "$option requires a non-empty value"
            if [[ $option == --repo ]]; then
                [[ -z $repo_request ]] || fail '--repo may be specified once'
                repo_request=$2
            else
                [[ -z $base_branch ]] || fail '--base may be specified once'
                base_branch=$2
            fi
            shift 2
            ;;
        --)
            shift
            request_parts+=("$@")
            break
            ;;
        -* )
            fail "unknown option: $1 (use --help)"
            ;;
        *)
            request_parts+=("$1")
            shift
            ;;
    esac
done
for required_command in hc herdr-app jq git realpath pi; do
    command -v "$required_command" >/dev/null 2>&1 || fail "required command '$required_command' not found"
done

script_path=$(realpath -e -- "${BASH_SOURCE[0]}") || fail 'cannot resolve launcher path'
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd -P)
repo_root=$(cd -- "$script_dir/../.." && pwd -P)
skill_file="$repo_root/.agents/skills/orchestrator/SKILL.md"
agent_reporting_skill="$repo_root/.agents/skills/agent-reporting/SKILL.md"
known_repos_skill="$repo_root/.agents/skills/known-repos/SKILL.md"
repo_map="$repo_root/.agents/skills/known-repos/repos.json"
[[ -f $skill_file ]] || fail "orchestrator skill missing: $skill_file"
[[ -f $agent_reporting_skill ]] || fail "agent-reporting skill missing: $agent_reporting_skill"
[[ -f $known_repos_skill ]] || fail "known-repos skill missing: $known_repos_skill"

terminal_id=${HC_TERMINAL_ID:-}
[[ -n $terminal_id ]] || fail 'run from a Herdr-managed terminal (HC_TERMINAL_ID is unset)'
herdr_listing=$(herdr-app ls) || fail 'cannot inspect Herdr terminals; ensure Herdr app is running'
if ! jq -e --arg terminal "$terminal_id" '
    [.spaces[].tabs[].terminals[] | select(.terminal == $terminal)] | length == 1
' <<<"$herdr_listing" >/dev/null; then
    fail "terminal $terminal_id is not present in Herdr"
fi

map_note=''
map_usable=false
if [[ -f $repo_map ]] && jq -e '
    def nonempty_string: type == "string" and (length > 0) and (test("^\\s*$") | not);
    def normalize: ascii_downcase | gsub("^\\s+|\\s+$"; "");
    if type != "object" or (.repositories | type) != "array" then false
    else
        all(.repositories[];
            if type != "object" then false
            elif (.alias | type) != "string" or (.alias | test("^[a-z0-9][a-z0-9._-]*$") | not) then false
            elif (.path | nonempty_string | not) or (.path | startswith("/") | not) then false
            elif (.github_repo | type) != "string" or (.github_repo | test("^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$") | not) then false
            elif has("synonyms") and ((.synonyms | type) != "array" or (any(.synonyms[]; nonempty_string | not))) then false
            else true end
        ) and
        ([.repositories[] | ([.alias] + (.synonyms // []))[] | normalize] | length == (unique | length))
    end
' "$repo_map" >/dev/null 2>&1; then
    map_usable=true
else
    map_note="Repository catalog unavailable or invalid at $repo_map; explicit user-selected paths remain valid."
    printf 'agent-orchestrator: %s\n' "$map_note" >&2
fi

selected_alias=''
selected_root=''
requested_target=$repo_request
repo_note=''
if [[ $requested_target == '~/'* ]]; then
    requested_target="$HOME/${requested_target:2}"
fi
if [[ -n $repo_request && $map_usable == true ]]; then
    needle=$(jq -nr --arg value "$repo_request" '$value | ascii_downcase | gsub("^\\s+|\\s+$"; "")')
    matches=$(jq -c --arg needle "$needle" '
        def normalize: ascii_downcase | gsub("^\\s+|\\s+$"; "");
        [.repositories[] | select(any(([.alias] + (.synonyms // []))[]; normalize == $needle))]
    ' "$repo_map")
    match_count=$(jq 'length' <<<"$matches")
    case $match_count in
        1)
            selected_alias=$(jq -r '.[0].alias' <<<"$matches")
            configured_path=$(jq -r '.[0].path' <<<"$matches")
            if [[ -d $configured_path ]]; then
                configured_path=$(realpath -e -- "$configured_path" 2>/dev/null || true)
                if [[ -n $configured_path ]]; then
                    selected_root=$(git -C "$configured_path" rev-parse --show-toplevel 2>/dev/null || true)
                    if [[ -n $selected_root ]]; then
                        selected_root=$(realpath -e -- "$selected_root" 2>/dev/null || true)
                    fi
                fi
            fi
            if [[ -z $selected_root ]]; then
                repo_note="Catalog match '$selected_alias' has no resolvable Git root at '$configured_path'; confirm the intended path with the user."
            fi
            ;;
        0)
            repo_note="'$repo_request' is not in the repository catalog; use only an exact path confirmed with the user."
            ;;
        *)
            repo_note="'$repo_request' matches multiple catalog entries; ask the user to confirm the intended repository path."
            ;;
    esac
fi
if [[ -n $repo_request && -z $selected_alias && -z $repo_note ]]; then
    repo_note="Use '$repo_request' only after resolving and confirming the exact repository/workspace path with the user."
fi
if [[ -n $requested_target && ( $requested_target == /* || $requested_target == ./* || $requested_target == ../* ) && -d $requested_target ]]; then
    explicit_path=$(realpath -e -- "$requested_target" 2>/dev/null || true)
    if [[ -n $explicit_path ]]; then
        selected_root=$(git -C "$explicit_path" rev-parse --show-toplevel 2>/dev/null || true)
        if [[ -n $selected_root ]]; then
            selected_root=$(realpath -e -- "$selected_root" 2>/dev/null || true)
        fi
        requested_target=$explicit_path
    fi
fi

initial_prompt='Start the multi-build orchestrator, follow the loaded orchestrator skill.'
if [[ -n $repo_request ]]; then
    initial_prompt+=$'\n\nUser-selected repository/workspace hint: '
    initial_prompt+="$requested_target"
fi
if [[ -n $selected_alias ]]; then
    initial_prompt+=$'\nCatalog alias: '
    initial_prompt+="$selected_alias"
    if [[ -n $selected_root ]]; then
        initial_prompt+=$'; resolved Git root: '
        initial_prompt+="$selected_root"
    fi
elif [[ -n $selected_root ]]; then
    initial_prompt+=$'\nResolved Git root (confirm exact path with user): '
    initial_prompt+="$selected_root"
fi
if [[ -n $repo_note ]]; then
    initial_prompt+=$'\nRepository resolution note: '
    initial_prompt+="$repo_note"
fi
if [[ -n $map_note ]]; then
    initial_prompt+=$'\n'
    initial_prompt+="$map_note"
fi
if [[ -n $base_branch ]]; then
    initial_prompt+=$'\nRequested base branch: '
    initial_prompt+="$base_branch"
fi
if ((${#request_parts[@]})); then
    request_text=$(printf '%s ' "${request_parts[@]}")
    request_text=${request_text% }
    initial_prompt+=$'\n\nUser request: '
    initial_prompt+="$request_text"
fi

cd -- "$HOME"
exec pi --skill "$skill_file" --skill "$agent_reporting_skill" --name 'Multi-Build Orchestrator' "$initial_prompt"
